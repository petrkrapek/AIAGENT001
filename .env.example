# Zkopírujte do .env a doplňte hodnoty.

# Povinné: API klíč z https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Povinné: všechna data agent ukládá do Airtable.
# Token vytvoříte na https://airtable.com/create/tokens s oprávněními
#   data.records:read, data.records:write, schema.bases:read, schema.bases:write
# a přístupem k vaší bázi. ID báze je v její URL (začíná "app").
# Tabulky pak vytvoříte příkazem: aiagent airtable-setup
# a v Airtable vyplníte tabulky Profil firmy a Služby.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Volitelné nastavení agenta
AIAGENT_MODEL=claude-opus-5-5
# Hloubka uvažování: low | medium | high | xhigh | max (vyšší = pečlivější, ale dražší a pomalejší)
AIAGENT_EFFORT=medium
AIAGENT_TIMEZONE=Europe/Prague
# Vyhledávání a čtení webu (1 = zapnuto, 0 = vypnuto)
AIAGENT_WEB_TOOLS=1
# Maximum odeslaných e-mailů za den
AIAGENT_DAILY_EMAIL_LIMIT=20
# Náhodná pauza v sekundách mezi dvěma e-maily jednoho běhu (0 = bez pauzy)
AIAGENT_SEND_PAUSE=30-90
# Odesílat jen ve všední dny v tyto hodiny (8-17 = od 8:00 do 16:59); prázdné = kdykoli
AIAGENT_SEND_HOURS=8-17
# Každou firmu prověřuje samostatný krátký běh agenta (1 = zapnuto, 0 = vše v jedné konverzaci)
AIAGENT_SUBAGENTS=1
# Model pro prověřování firem; prázdné = stejný jako AIAGENT_MODEL (levnější volba: claude-sonnet-5-5)
AIAGENT_SUBAGENT_MODEL=
# Od kolika tokenů historie se mažou starší výsledky nástrojů (0 = vypnuto, jinak aspoň 20000)
AIAGENT_CONTEXT_TRIGGER=60000
# Servery, na které smí běh s --yes posílat HTTP požadavky bez dotazu, oddělené čárkou
# (např. hook.eu1.make.com); prázdné = s --yes žádné
AIAGENT_HTTP_ALLOWED_HOSTS=

# Odesílání e-mailů přes SMTP (funguje stejně v Dockeru i bez něj).
# Ověření nastavení: aiagent smtp-test --to vas@email.cz
#   v Dockeru:      docker compose run --rm agent smtp-test --to vas@email.cz
SMTP_HOST=
# 587 = STARTTLS (běžné), 465 = SSL
SMTP_PORT=587
# starttls | ssl | none (výchozí: ssl pro port 465, jinak starttls)
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Kopie odeslaných e-mailů do složky Odeslané (IMAP přes SSL). U Gmailu nevyplňujte,
# ten odeslanou poštu ukládá sám; Microsoft 365 přihlášení heslem přes IMAP nepovoluje.
# Seznam: imap.seznam.cz
IMAP_HOST=
IMAP_PORT=993
# Prázdné = stejné jako SMTP_USER / SMTP_PASSWORD
IMAP_USER=
IMAP_PASSWORD=
# Prázdné = agent složku Odeslané najde sám
IMAP_SENT_FOLDER=

# Režim odesílání:
#   off     = jen návrhy, nic se neodesílá
#   approve = každý e-mail před odesláním schvalujete (výchozí, když je SMTP nastavené)
#   auto    = odesílá bez dotazu, ale jen návrhy, které jste schválili v Airtable
#             (pole Schválení návrhu = Schváleno); pro běh bez terminálu, cron
# Prázdné = approve, když je SMTP nastavené, jinak off.
AIAGENT_SEND_MODE=

# Logování na stderr (WARNING, INFO = i spotřeba tokenů u každého volání modelu)
AIAGENT_LOG_LEVEL=WARNING
