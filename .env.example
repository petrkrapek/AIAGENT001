# Zkopírujte do .env a doplňte hodnoty.

# Povinné: API klíč z https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Povinné: všechna data agent ukládá do Airtable.
# Token vytvoříte na https://airtable.com/create/tokens s oprávněními
#   data.records:read, data.records:write, schema.bases:read, schema.bases:write
# a přístupem k vaší bázi. ID báze je v její URL (začíná "app").
# Tabulky pak vytvoříte příkazem: aiagent airtable-setup
# a v Airtable vyplníte tabulky Profil firmy a Služby.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Volitelné nastavení agenta
AIAGENT_MODEL=claude-opus-5-5
# Hloubka uvažování: low | medium | high | xhigh | max
AIAGENT_EFFORT=high
AIAGENT_TIMEZONE=Europe/Prague
# Vyhledávání a čtení webu (1 = zapnuto, 0 = vypnuto)
AIAGENT_WEB_TOOLS=1
# Maximum odeslaných e-mailů za den
AIAGENT_DAILY_EMAIL_LIMIT=20

# Odesílání e-mailů přes SMTP (funguje stejně v Dockeru i bez něj).
# Ověření nastavení: aiagent smtp-test --to vas@email.cz
#   v Dockeru:      docker compose run --rm agent smtp-test --to vas@email.cz
SMTP_HOST=
# 587 = STARTTLS (běžné), 465 = SSL
SMTP_PORT=587
# starttls | ssl | none (výchozí: ssl pro port 465, jinak starttls)
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Režim odesílání:
#   off     = jen návrhy, nic se neodesílá
#   approve = každý e-mail před odesláním schvalujete (výchozí, když je SMTP nastavené)
#   auto    = odesílá bez schvalování, jen přesně uložené návrhy (pro běh bez terminálu, cron)
AIAGENT_SEND_MODE=approve
