# Zkopírujte do .env a doplňte hodnoty.

# Povinné: API klíč z https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Volitelné nastavení agenta
AIAGENT_MODEL=claude-opus-5-5
# Hloubka uvažování: low | medium | high | xhigh | max
AIAGENT_EFFORT=high
# Adresář, ve kterém smí agent číst a zapisovat soubory a spouštět příkazy
AIAGENT_WORKSPACE=./workspace
AIAGENT_TIMEZONE=Europe/Prague
# Vyhledávání a čtení webu (1 = zapnuto, 0 = vypnuto)
AIAGENT_WEB_TOOLS=1

# Volitelné: odesílání e-mailů přes SMTP (bez SMTP_HOST se nástroj nenačte)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
